# Copy this file to .env and fill it in. .env is never committed.
# Setup steps are in the README under "Owner sign-in".

# From Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
GOOGLE_CLIENT_ID=

# The Google account allowed to edit the site (your Gmail address)
OWNER_EMAIL=

# A long random string. Make one with:  openssl rand -base64 48
SESSION_SECRET=

# Optional. Lets the build read portfolio.json from your private agent repos.
# GitHub > Settings > Developer settings > Fine-grained tokens: only the agent repos,
# Repository permissions: Contents = Read-only (Metadata read-only is added automatically).
GITHUB_TOKEN=
