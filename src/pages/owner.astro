---
// Owner sign-in page. Linked quietly from the footer.
import Base from '../layouts/Base.astro';
import { GOOGLE_CLIENT_ID } from 'astro:env/client';
---
<Base title="Owner sign-in">
  <section class="mx-auto flex min-h-[70vh] max-w-md flex-col justify-center px-5 pt-24">
    <h1 class="font-serif text-4xl">Owner sign-in</h1>
    <p class="mt-3 text-muted">This is only for the site owner. Signing in lets you edit text on the page. The site only learns your email address from Google; it gets no access to your Google account.</p>
    {GOOGLE_CLIENT_ID ? (
      <div class="mt-8" id="gsi" data-client-id={GOOGLE_CLIENT_ID}></div>
    ) : (
      <p class="mt-8 rounded-xl border border-dashed border-line p-4 text-sm text-muted">Google sign-in isn't set up yet. Add your keys to the <code>.env</code> file (see the README).</p>
    )}
    <p id="login-msg" class="mt-4 min-h-6 text-sm text-muted" role="status"></p>
  </section>
  <script is:inline src="https://accounts.google.com/gsi/client" async defer></script>
  <script>
    const box = document.getElementById('gsi');
    const msg = document.getElementById('login-msg')!;
    async function start() {
      if (!box) return;
      // @ts-ignore Google's script adds window.google
      const g = window.google;
      if (!g?.accounts?.id) return void setTimeout(start, 100);
      const r = await fetch('/api/auth/nonce', { method: 'POST' });
      if (!r.ok) { msg.textContent = (await r.json()).error ?? 'Sign-in is unavailable.'; return; }
      const { nonce } = await r.json();
      g.accounts.id.initialize({
        client_id: box.dataset.clientId,
        nonce,
        auto_select: false,
        use_fedcm_for_button: true,
        callback: async ({ credential }: { credential: string }) => {
          msg.textContent = 'Checking…';
          const res = await fetch('/api/auth/login', {
            method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ credential }),
          });
          if (res.ok) { msg.textContent = 'Signed in. Taking you back…'; location.href = '/'; }
          else { msg.textContent = (await res.json()).error ?? 'Sign-in failed.'; setTimeout(() => location.reload(), 2500); }
        },
      });
      g.accounts.id.renderButton(box, { theme: 'filled_black', size: 'large', shape: 'pill', text: 'signin_with' });
    }
    start();
  </script>
</Base>
