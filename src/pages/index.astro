---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Placeholder from '../components/Placeholder.astro';
import Timeline from '../components/Timeline.astro';
import Carousel from '../components/Carousel.astro';
import MediaSlide from '../components/MediaSlide.astro';
import GalleryCard from '../components/GalleryCard.astro';
import { site, content } from '../data/site';
import { highlights, beyond } from '../data/media';
import ProjectCard from '../components/ProjectCard.astro';
import { getProjects } from '../lib/portfolio';
const projects = await getProjects();

---
<Base>
  <Hero />

  <Section id="about">
    <div class="grid gap-10 md:grid-cols-2">
      <ul class="space-y-4">
        {content.now.map((item, i) => (
          <li class="flex gap-3 leading-relaxed text-muted"><span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"></span><span data-edit={`now.${i}`}>{item}</span></li>
        ))}
      </ul>
      <div class="rounded-2xl border border-line bg-panel p-7">
        <p class="text-xs tracking-widest text-accent uppercase">Looking for</p>
        <p class="mt-3 font-serif text-2xl leading-snug" data-edit="lookingFor">{content.lookingFor}</p>
        <a href="#contact" class="mt-6 inline-block text-sm text-accent hover:underline">Get in touch →</a>
      </div>
    </div>

    <div class="mt-16">
      <h3 class="font-serif text-2xl" data-edit="highlights.title">{content.highlights.title}</h3>
      <p class="mt-1 mb-6 text-sm text-muted" data-edit="highlights.subtitle">{content.highlights.subtitle}</p>
      <Carousel label="Recent highlights" count={highlights.length}>
        {highlights.map((item) => (
          <div class="w-[80%] shrink-0 snap-start sm:w-[46%] lg:w-[31%]"><MediaSlide item={item} /></div>
        ))}
      </Carousel>
    </div>
  </Section>

  <Section id="journey">
    <a href="/quest" class="group mb-14 flex flex-col gap-5 rounded-2xl border border-line bg-panel p-6 transition hover:border-accent/60 sm:flex-row sm:items-center sm:justify-between sm:p-8">
      <div>
        <p class="text-xs tracking-widest text-accent uppercase">Play instead of read</p>
        <p class="mt-2 font-serif text-2xl sm:text-3xl">Career quest</p>
        <p class="mt-2 max-w-xl text-muted">A small retro adventure: walk from campus to the city to the lake, and each marker you find unlocks the next stage of my career.</p>
      </div>
      <span class="shrink-0 rounded-full bg-accent px-5 py-2.5 text-sm font-medium text-accent-ink transition group-hover:brightness-110">Start the quest →</span>
    </a>
    <Timeline />
  </Section>

  <Section id="projects">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {projects.slice(0, 6).map((p) => <ProjectCard p={p} />)}
    </div>
    <a href="/projects" class="mt-8 inline-block text-sm text-accent hover:underline">All projects, with filters →</a>
  </Section>

  <Section id="twin" comingIn="step 5 (retro dialogue chat)">
    <Placeholder label="A retro handheld-RPG-style dialogue box where you can chat with a pixel-art version of me." />
  </Section>

  <Section id="beyond">
    <div class="grid grid-cols-2 gap-x-5 gap-y-10 lg:grid-cols-4">
      {beyond.map((b) => <GalleryCard id={b.id} items={b.items} title={content.beyond[b.id].title} blurb={content.beyond[b.id].blurb} />)}
    </div>
  </Section>

  <Section id="contact">
    <p class="max-w-xl text-lg text-muted">
      <span data-edit="contact">{content.contact}</span> <a class="text-accent hover:underline" href={`mailto:${site.email}`}>{site.email}</a>
    </p>
  </Section>
</Base>
