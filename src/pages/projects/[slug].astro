---
import Base from '../../layouts/Base.astro';
import { getProjects, formatDate, type Project } from '../../lib/portfolio';
import { statusLabels } from '../../data/projects';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((p, i) => ({ params: { slug: p.slug }, props: { p, next: projects[(i + 1) % projects.length] } }));
}
interface Props { p: Project; next: Project }
const { p, next } = Astro.props;
const links = [
  p.links?.demo && { href: p.links.demo, label: 'Try the demo' },
  p.links?.video && { href: p.links.video, label: 'Watch the video' },
  p.links?.site && { href: p.links.site, label: 'Visit the site' },
  p.repoUrl && { href: p.repoUrl, label: 'View the code' },
].filter(Boolean) as { href: string; label: string }[];
---
<Base title={`${p.name} · Ryan Kim`} description={p.tagline}>
  <article class="mx-auto max-w-3xl px-5 pt-28 pb-24 sm:px-8">
    <a href="/projects" class="text-sm text-muted hover:text-text">← All projects</a>
    <p class="mt-8 text-sm tracking-[0.2em] text-accent uppercase">
      {statusLabels[p.status] ?? p.status}{p.updated && <span class="text-muted"> · Updated {formatDate(p.updated)}</span>}
    </p>
    <h1 class="mt-2 font-serif text-4xl tracking-tight sm:text-5xl">{p.name}</h1>
    <p class="mt-4 text-xl leading-relaxed text-muted">{p.tagline}</p>
    <ul class="mt-6 flex flex-wrap gap-2">
      {p.tags.map((t) => <li><a href={`/projects?tag=${encodeURIComponent(t)}`} class="rounded-full border border-line px-3 py-1 text-xs text-muted hover:border-accent/60 hover:text-text">{t}</a></li>)}
    </ul>

    {links.length > 0 && (
      <div class="mt-8 flex flex-wrap gap-3">
        {links.map((l, i) => (
          <a href={l.href} target="_blank" rel="noopener" class={i === 0 ? 'rounded-full bg-accent px-5 py-2.5 text-sm font-medium text-accent-ink hover:brightness-110' : 'rounded-full border border-line px-5 py-2.5 text-sm hover:border-accent/60'}>{l.label} ↗</a>
        ))}
      </div>
    )}

    <div class="mt-12 rounded-2xl border border-dashed border-line p-8 text-center text-sm text-muted">Interactive demo and launch video coming in step 4.</div>

    <section class="mt-14">
      <p class="leading-relaxed text-lg">{p.summary}</p>
    </section>

    {p.problem && (
      <section class="mt-12">
        <h2 class="font-serif text-2xl">The problem</h2>
        <p class="mt-3 leading-relaxed text-muted">{p.problem}</p>
      </section>
    )}

    {p.how && p.how.length > 0 && (
      <section class="mt-12">
        <h2 class="font-serif text-2xl">How it works</h2>
        <ol class="mt-5 space-y-4">
          {p.how.map((step, i) => (
            <li class="flex gap-4"><span class="font-serif text-xl text-accent tabular-nums">{String(i + 1).padStart(2, '0')}</span><span class="leading-relaxed text-muted">{step}</span></li>
          ))}
        </ol>
      </section>
    )}

    <div class="mt-12 grid gap-8 sm:grid-cols-2">
      {p.stack && p.stack.length > 0 && (
        <section>
          <h2 class="text-xs tracking-widest text-accent uppercase">Built with</h2>
          <ul class="mt-3 flex flex-wrap gap-2">{p.stack.map((s) => <li class="rounded-md bg-panel px-2.5 py-1 text-sm">{s}</li>)}</ul>
        </section>
      )}
      {p.highlights && p.highlights.length > 0 && (
        <section>
          <h2 class="text-xs tracking-widest text-accent uppercase">Highlights</h2>
          <ul class="mt-3 space-y-2">{p.highlights.map((h) => <li class="flex gap-3 text-muted"><span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"></span>{h}</li>)}</ul>
        </section>
      )}
    </div>

    {next.slug !== p.slug && (
      <a href={`/projects/${next.slug}`} class="mt-20 block rounded-2xl border border-line bg-panel p-6 transition hover:border-accent/60">
        <p class="text-xs tracking-widest text-muted uppercase">Next project</p>
        <p class="mt-2 font-serif text-2xl">{next.name} →</p>
      </a>
    )}
  </article>
</Base>
