---
import Base from '../../layouts/Base.astro';
import { getProjects, formatDate, type Project } from '../../lib/portfolio';
import { statusLabels } from '../../data/projects';
import { content } from '../../data/site';
import DemoPlayer from '../../components/DemoPlayer.astro';
import { getDemo, getVideo } from '../../lib/demos';
const t = content.ui.projects;

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((p, i) => ({ params: { slug: p.slug }, props: { p, next: projects[(i + 1) % projects.length] } }));
}
interface Props { p: Project; next: Project }
const { p, next } = Astro.props;
const k = (f: string) => `project:${p.slug}:${f}`;
const demo = getDemo(p.slug);
const video = getVideo(p.slug);
const links = [
  demo && { href: '#demo', label: 'Watch the demo', local: true },
  p.links?.demo && { href: p.links.demo, label: demo ? 'Open the interactive mockup' : 'Try the demo' },
  !video && p.links?.video && { href: p.links.video, label: 'Watch the video' },
  p.links?.site && { href: p.links.site, label: 'Visit the site' },
  p.repoUrl && { href: p.repoUrl, label: 'View the code' },
].filter(Boolean) as { href: string; label: string; local?: boolean }[];
---
<Base title={`${p.name} · Ryan Kim`} description={p.tagline}>
  <article class="mx-auto max-w-3xl px-5 pt-28 pb-24 sm:px-8">
    <a href="/projects" class="text-sm text-muted hover:text-text" data-edit="ui.projects.backLink">{t.backLink}</a>
    <p class="mt-8 text-sm tracking-[0.2em] text-accent uppercase">
      {statusLabels[p.status] ?? p.status}{p.updated && <span class="text-muted"> · Updated {formatDate(p.updated)}</span>}
    </p>
    <h1 class="mt-2 font-serif text-4xl tracking-tight sm:text-5xl" data-edit={k('name')}>{p.name}</h1>
    <p class="mt-4 text-xl leading-relaxed text-muted" data-edit={k('tagline')}>{p.tagline}</p>
    <ul class="mt-6 flex flex-wrap gap-2">
      {p.tags.map((tag, i) => <li><a href={`/projects?tag=${encodeURIComponent(tag)}`} class="rounded-full border border-line px-3 py-1 text-xs text-muted hover:border-accent/60 hover:text-text" data-edit={k(`tags.${i}`)}>{tag}</a></li>)}
    </ul>

    {links.length > 0 && (
      <div class="mt-8 flex flex-wrap gap-3">
        {links.map((l, i) => (
          <a href={l.href} target={l.local ? undefined : '_blank'} rel={l.local ? undefined : 'noopener'} class={i === 0 ? 'rounded-full bg-accent px-5 py-2.5 text-sm font-medium text-accent-ink hover:brightness-110' : 'rounded-full border border-line px-5 py-2.5 text-sm hover:border-accent/60'}>{l.label}{l.local ? ' ↓' : ' ↗'}</a>
        ))}
      </div>
    )}

    {video && (
      <figure class="mt-12">
        <video class="w-full rounded-2xl border border-line bg-panel" src={video.src} poster={video.poster} controls playsinline muted preload="metadata"></video>
        <figcaption class="mt-2 text-xs text-muted" data-edit="ui.projects.videoHeading">{t.videoHeading}</figcaption>
      </figure>
    )}

    {demo
      ? <div id="demo" class="mt-12 scroll-mt-24"><DemoPlayer demo={demo} slug={p.slug} /></div>
      : <div class="mt-12 rounded-2xl border border-dashed border-line p-8 text-center text-sm text-muted" data-edit="ui.projects.demoPlaceholder">{t.demoPlaceholder}</div>}

    <section class="mt-14">
      <p class="leading-relaxed text-lg" data-edit={k('summary')}>{p.summary}</p>
    </section>

    {p.problem && (
      <section class="mt-12">
        <h2 class="font-serif text-2xl" data-edit="ui.projects.problemHeading">{t.problemHeading}</h2>
        <p class="mt-3 leading-relaxed text-muted" data-edit={k('problem')}>{p.problem}</p>
      </section>
    )}

    {p.how && p.how.length > 0 && (
      <section class="mt-12">
        <h2 class="font-serif text-2xl" data-edit="ui.projects.howHeading">{t.howHeading}</h2>
        <ol class="mt-5 space-y-4">
          {p.how.map((step, i) => (
            <li class="flex gap-4"><span class="font-serif text-xl text-accent tabular-nums">{String(i + 1).padStart(2, '0')}</span><span class="leading-relaxed text-muted" data-edit={k(`how.${i}`)}>{step}</span></li>
          ))}
        </ol>
      </section>
    )}

    <div class="mt-12 grid gap-8 sm:grid-cols-2">
      {p.stack && p.stack.length > 0 && (
        <section>
          <h2 class="text-xs tracking-widest text-accent uppercase" data-edit="ui.projects.stackHeading">{t.stackHeading}</h2>
          <ul class="mt-3 flex flex-wrap gap-2">{p.stack.map((s, i) => <li class="rounded-md bg-panel px-2.5 py-1 text-sm" data-edit={k(`stack.${i}`)}>{s}</li>)}</ul>
        </section>
      )}
      {p.highlights && p.highlights.length > 0 && (
        <section>
          <h2 class="text-xs tracking-widest text-accent uppercase" data-edit="ui.projects.highlightsHeading">{t.highlightsHeading}</h2>
          <ul class="mt-3 space-y-2">{p.highlights.map((h, i) => <li class="flex gap-3 text-muted"><span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"></span><span data-edit={k(`highlights.${i}`)}>{h}</span></li>)}</ul>
        </section>
      )}
    </div>

    {next.slug !== p.slug && (
      <a href={`/projects/${next.slug}`} class="mt-20 block rounded-2xl border border-line bg-panel p-6 transition hover:border-accent/60">
        <p class="text-xs tracking-widest text-muted uppercase" data-edit="ui.projects.nextLabel">{t.nextLabel}</p>
        <p class="mt-2 font-serif text-2xl">{next.name} →</p>
      </a>
    )}
  </article>
</Base>
