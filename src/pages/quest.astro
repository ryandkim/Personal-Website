---
import Base from '../layouts/Base.astro';
import Quest from '../components/Quest.astro';
import { content } from '../data/site';
const t = content.ui.quest;
---
<Base title="Career quest · Ryan Kim" description="Explore Ryan Kim's career as a small retro adventure.">
  <section class="mx-auto max-w-5xl px-5 pt-24 pb-16 sm:px-8">
    <p class="mb-3 text-sm tracking-[0.2em] text-accent uppercase" data-edit="ui.quest.eyebrow">{t.eyebrow}</p>
    <h1 class="font-serif text-4xl tracking-tight sm:text-5xl" data-edit="ui.quest.title">{t.title}</h1>
    <p class="mt-3 max-w-2xl text-muted">
      <span data-edit="ui.quest.intro">{t.intro}</span>{' '}
      <a href="/#journey" class="text-accent hover:underline" data-edit="ui.quest.readLink">{t.readLink}</a>
    </p>
    <div class="mt-8"><Quest /></div>
  </section>
</Base>
