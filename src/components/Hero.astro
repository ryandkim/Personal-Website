---
import '@fontsource/pixelify-sans/400.css';
import '@fontsource/pixelify-sans/600.css';
import { site, content } from '../data/site';
import twin from '../content/twin.json';
const t = content.ui.twin;
const byId = new Map(twin.answers.map((a, i) => [a.id, { ...a, i }]));
const chips = twin.suggestions.map((id) => byId.get(id)).filter((a) => a !== undefined);

// Original pixel-art portrait for the back of the card (16 x 16). Each letter
// is a palette color, '.' is transparent.
const PAL: Record<string, string> = {
  h: '#2a1d17', H: '#3d2a20', s: '#f1c7a1', S: '#dfa983', e: '#1b1b1b', m: '#a65a45',
  j: '#f2b544', J: '#c98d24', w: '#ecebe6',
};
const portrait = [
  '.....hhhhhh.....',
  '...hhhHHHHhhh...',
  '..hhhhhhhhhhhh..',
  '..hhhhhhhhhhhh..',
  '..hhssssssshhh..',
  '..hssssssssssh..',
  '..sseessssseeS..',
  '..sssssssssssS..',
  '..ssssssssssss..',
  '...ssssmmmsss...',
  '....ssssssss....',
  '......SSSS......',
  '...jjjwwwwjjj...',
  '..jjjjjwwjjjjj..',
  '.jjjjjjwwjjjjjJ.',
  '.JjjjjjjjjjjjjJ.',
];
const pixels = portrait.flatMap((row, y) => [...row].flatMap((c, x) => (PAL[c] ? [{ x, y, fill: PAL[c], eye: c === 'e' }] : [])));
---
<section id="top" class="mx-auto grid max-w-6xl items-center gap-12 px-5 pt-32 pb-20 sm:px-8 md:grid-cols-[1.2fr_1fr] md:items-start md:pt-40 md:pb-28">
  <div class="reveal order-2 md:order-1 md:pt-10">
    <p class="mb-4 text-sm tracking-[0.2em] text-accent uppercase" data-edit="hero.greeting">{content.hero.greeting}</p>
    <h1 class="font-serif text-5xl leading-[1.05] tracking-tight sm:text-6xl lg:text-7xl" data-edit="name">{content.name}</h1>
    <p class="mt-6 max-w-xl text-xl" data-edit="hero.headline" data-placeholder="Headline goes here. Sign in and click Edit to write it.">{content.hero.headline}</p>
    <p class="mt-4 max-w-xl leading-relaxed text-muted" data-edit="hero.bio" data-placeholder="A short bio goes here: two or three sentences about who you are and what you build.">{content.hero.bio}</p>
    <div class="mt-9 flex flex-wrap gap-3">
      <a href="#projects" class="rounded-full bg-accent px-5 py-2.5 text-sm font-medium text-accent-ink transition hover:brightness-110"><span data-edit="ui.hero.projectsButton">{content.ui.hero.projectsButton}</span></a>
      <a href="#journey" class="rounded-full border border-line px-5 py-2.5 text-sm transition hover:border-text"><span data-edit="ui.hero.journeyButton">{content.ui.hero.journeyButton}</span></a>
    </div>
  </div>

  <div class="reveal order-1 mx-auto w-64 sm:w-72 md:order-2 md:w-full md:max-w-sm" data-twin>
    <div class="relative">
      <div class="absolute -inset-3 -z-10 rounded-[2rem] bg-accent/10 blur-2xl"></div>
      <div class="twin-card">
        <div class="twin-inner">
          <div class="twin-face twin-front">
            <img src="/images/headshot.jpg" alt={`Portrait of ${site.name}`} width="800" height="1000"
                 class="aspect-[4/5] w-full rounded-[1.75rem] border border-line object-cover" fetchpriority="high" />
          </div>
          <div class="twin-face twin-back" aria-hidden="true">
            <div class="twin-screen">
              <svg viewBox="0 0 16 16" class="twin-sprite" shape-rendering="crispEdges" role="img" aria-label={`Pixel-art ${site.name}`}>
                {pixels.map((p) => <rect x={p.x} y={p.y} width="1" height="1" fill={p.fill} class={p.eye ? 'twin-eye' : undefined} />)}
              </svg>
              <p class="twin-name" data-edit="ui.twin.backTitle">{t.backTitle}</p>
              <p class="twin-sub" data-edit="ui.twin.backText">{t.backText}</p>
            </div>
          </div>
        </div>
        <button type="button" class="twin-flip" data-twin-flip aria-expanded="false" aria-controls="twin-chat">
          <span class="twin-flip-icon" aria-hidden="true">↻</span>
          <span data-twin-flip-label="front" data-edit="ui.twin.flip">{t.flip}</span>
          <span data-twin-flip-label="back" data-edit="ui.twin.flipBack" hidden>{t.flipBack}</span>
        </button>
      </div>
    </div>

    <div id="twin-chat" class="twin-chat" data-twin-chat hidden>
      <div class="twin-log" data-twin-log role="log" aria-live="polite">
        <p class="twin-msg twin-ai" data-edit="ui.twin.greeting">{t.greeting}</p>
      </div>
      <p class="twin-chips-label" data-edit="ui.twin.suggestionsLabel">{t.suggestionsLabel}</p>
      <div class="twin-chips" data-twin-chips>
        {chips.map((a) => <button type="button" data-twin-ask={a.id} data-edit={`twin:answers.${a.i}.label`}>{a.label}</button>)}
      </div>
      <form class="twin-form" data-twin-form>
        <label for="twin-input" class="sr-only" data-edit="ui.twin.inputLabel">{t.inputLabel}</label>
        <input id="twin-input" name="message" autocomplete="off" maxlength="300" placeholder="Ask me something..." />
        <button type="submit" data-edit="ui.twin.send">{t.send}</button>
      </form>
      <div class="twin-foot">
        <span data-edit="ui.twin.note">{t.note}</span>
        <button type="button" data-twin-restart data-edit="ui.twin.restart">{t.restart}</button>
      </div>
      <!-- The saved answers. Hidden from visitors; shown in owner Edit mode so you can edit them on the page. -->
      <div class="twin-strings" data-twin-answers>
        {twin.answers.map((a, i) => (
          <div data-id={a.id} data-keywords={a.keywords.join(' ')}>
            <b data-edit={`twin:answers.${i}.label`}>{a.label}</b>
            <span data-answer data-edit={`twin:answers.${i}.answer`}>{a.answer}</span>
          </div>
        ))}
        <div><b>No match</b> <span data-fallback data-edit="twin:fallback">{twin.fallback}</span></div>
      </div>
    </div>
  </div>
</section>

<style>
  .twin-card { position: relative; perspective: 1400px; }
  .twin-inner { position: relative; transform-style: preserve-3d; transition: transform .8s cubic-bezier(.2,.7,.2,1); }
  [data-twin].flipped .twin-inner { transform: rotateY(180deg); }
  .twin-face { backface-visibility: hidden; -webkit-backface-visibility: hidden; }
  .twin-back { position: absolute; inset: 0; transform: rotateY(180deg); }
  .twin-screen {
    height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .6rem;
    padding: 1.5rem; text-align: center; border-radius: 1.75rem; border: 1px solid var(--color-line);
    background-color: var(--color-panel);
    background-image: radial-gradient(circle at 50% 38%, #2a2416 0, transparent 62%),
      repeating-linear-gradient(0deg, rgba(255,255,255,.025) 0 2px, transparent 2px 4px);
    font-family: 'Pixelify Sans', monospace;
  }
  .twin-sprite { width: 58%; image-rendering: pixelated; filter: drop-shadow(0 6px 0 rgba(0,0,0,.35)); animation: twin-bob 2.4s steps(2) infinite; }
  .twin-eye { animation: twin-blink 4s steps(1) infinite; }
  .twin-name { font-size: 1.6rem; font-weight: 600; color: var(--color-accent); text-shadow: 2px 2px 0 #000; }
  .twin-sub { max-width: 16rem; font-size: .95rem; color: var(--color-muted); line-height: 1.35; }
  @keyframes twin-bob { 50% { transform: translateY(-3%); } }
  @keyframes twin-blink { 0%, 94% { opacity: 1; } 95%, 100% { opacity: 0; } }

  .twin-flip {
    position: absolute; left: 50%; bottom: .9rem; transform: translateX(-50%); z-index: 2;
    display: flex; align-items: center; gap: .45rem; white-space: nowrap;
    border-radius: 999px; border: 1px solid var(--color-line); background: color-mix(in oklab, var(--color-ink) 82%, transparent);
    backdrop-filter: blur(6px); padding: .5rem 1rem; font-size: .85rem; transition: border-color .2s, color .2s;
  }
  .twin-flip:hover, .twin-flip:focus-visible { border-color: var(--color-accent); color: var(--color-accent); }
  .twin-flip-icon { display: inline-block; transition: transform .6s; }
  [data-twin].flipped .twin-flip-icon { transform: rotate(-180deg); }

  .twin-chat {
    margin-top: 1.25rem; font-family: 'Pixelify Sans', monospace;
    border: 3px solid var(--color-text); border-radius: .5rem; background: #0f1013;
    box-shadow: inset 0 0 0 3px #0f1013, inset 0 0 0 5px var(--color-accent), 0 6px 0 #000;
    padding: .9rem; animation: twin-in .45s ease;
  }
  @keyframes twin-in { from { opacity: 0; transform: translateY(-8px); } }
  .twin-log { max-height: 16rem; overflow-y: auto; display: flex; flex-direction: column; gap: .6rem; padding: .25rem .25rem .5rem; overscroll-behavior: contain; }
  .twin-msg { font-size: 1rem; line-height: 1.4; white-space: pre-wrap; overflow-wrap: anywhere; }
  .twin-ai { color: var(--color-text); }
  .twin-ai::before { content: '▸ '; color: var(--color-accent); }
  .twin-me { align-self: flex-end; max-width: 85%; color: var(--color-accent); text-align: right; }
  .twin-chips-label { margin-top: .4rem; font-size: .75rem; letter-spacing: .12em; text-transform: uppercase; color: var(--color-muted); }
  .twin-chips { display: flex; flex-wrap: wrap; gap: .4rem; margin: .4rem 0 .7rem; }
  .twin-chips button { border: 2px solid var(--color-line); border-radius: .3rem; padding: .2rem .55rem; font-size: .85rem; transition: border-color .2s, color .2s; }
  .twin-chips button:hover, .twin-chips button:focus-visible { border-color: var(--color-accent); color: var(--color-accent); }
  .twin-form { display: flex; gap: .5rem; border-top: 2px dashed var(--color-line); padding-top: .7rem; }
  .twin-form input {
    flex: 1; min-width: 0; background: transparent; border: 2px solid var(--color-line); border-radius: .3rem;
    padding: .45rem .6rem; font: inherit; font-size: 1rem; color: var(--color-text);
  }
  .twin-form input:focus { outline: none; border-color: var(--color-accent); }
  .twin-form button { border-radius: .3rem; background: var(--color-accent); color: var(--color-accent-ink); padding: 0 .9rem; font-weight: 600; }
  .twin-form button:disabled, .twin-form input:disabled { opacity: .5; }
  .twin-foot { display: flex; justify-content: space-between; gap: .75rem; margin-top: .55rem; font-size: .78rem; color: var(--color-muted); }
  .twin-foot button { flex-shrink: 0; text-decoration: underline; }
  .twin-strings { display: none; }
  .twin-strings b { display: block; color: var(--color-text); font-weight: 600; }
  :global(body.editing) .twin-strings { display: flex; flex-direction: column; gap: .6rem; border-top: 2px dashed var(--color-line); padding-top: .75rem; margin-top: .75rem; font-size: .8rem; color: var(--color-muted); }
  .twin-foot button:hover { color: var(--color-accent); }

  @media (prefers-reduced-motion: reduce) {
    .twin-inner, .twin-flip-icon { transition: none; }
    .twin-sprite, .twin-eye, .twin-chat { animation: none; }
  }
</style>

<script>
  // AI Ryan answers from saved notes (src/content/twin.json), right here in the
  // browser: no AI call, so it costs nothing per visit.
  type Msg = { role: 'user' | 'assistant'; content: string };
  const root = document.querySelector<HTMLElement>('[data-twin]');
  if (root) {
    const flip = root.querySelector<HTMLButtonElement>('[data-twin-flip]')!;
    const chat = root.querySelector<HTMLElement>('[data-twin-chat]')!;
    const log = root.querySelector<HTMLElement>('[data-twin-log]')!;
    const form = root.querySelector<HTMLFormElement>('[data-twin-form]')!;
    const input = form.querySelector('input')!;
    const back = root.querySelector<HTMLElement>('.twin-back')!;
    const front = root.querySelector<HTMLElement>('.twin-front')!;
    const answersEl = root.querySelector<HTMLElement>('[data-twin-answers]')!;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const editing = () => document.body.classList.contains('editing');

    // Read answers from the page so on-page edits apply right away.
    const answers = [...answersEl.querySelectorAll<HTMLElement>('[data-id]')].map((el) => ({
      id: el.dataset.id!,
      keywords: (el.dataset.keywords ?? '').split(' ').filter(Boolean),
      answer: () => el.querySelector('[data-answer]')?.textContent?.trim() ?? '',
      label: () => el.querySelector('b')?.textContent?.trim() ?? '',
    }));
    const fallback = () => answersEl.querySelector('[data-fallback]')?.textContent?.trim() ?? '';

    const STOP = new Set(['a', 'an', 'the', 'is', 'are', 'was', 'were', 'do', 'does', 'did', 'i', 'me', 'my', 'your', 'yours', 'to', 'of', 'in', 'on', 'for', 'and', 'or', 'what', 'whats', 'how', 'why', 'where', 'when', 'can', 'could', 'would', 'tell', 'about', 'any', 'have', 'has', 'you', 'it', 'that', 'this', 'with', 'at', 'be', 'so']);
    const words = (s: string) => s.toLowerCase().replace(/[’']/g, '').split(/[^a-z0-9&:]+/).filter((w) => w && !STOP.has(w));
    const hit = (w: string, k: string) => w === k || (k.length >= 4 && w.length >= 4 && (w.startsWith(k) || k.startsWith(w)));

    // Pick the saved answer whose keywords (and label) overlap the question most.
    function match(q: string) {
      const qw = words(q);
      let best: (typeof answers)[number] | null = null, top = 0;
      for (const a of answers) {
        const keys = [...a.keywords, ...words(a.label())];
        const score = qw.filter((w) => keys.some((k) => hit(w, k))).length;
        if (score > top) { top = score; best = a; }
      }
      return best ? best.answer() : fallback();
    }

    const store = {
      get(): Msg[] { try { return JSON.parse(sessionStorage.getItem('twin-history') ?? '[]'); } catch { return []; } },
      set(v: Msg[]) { try { sessionStorage.setItem('twin-history', JSON.stringify(v)); } catch {} },
    };
    let history = store.get();
    let busy = false;

    function setFlipped(on: boolean) {
      root!.classList.toggle('flipped', on);
      chat.hidden = !on;
      flip.setAttribute('aria-expanded', String(on));
      back.setAttribute('aria-hidden', String(!on));
      front.setAttribute('aria-hidden', String(on));
      root!.querySelectorAll<HTMLElement>('[data-twin-flip-label]').forEach((el) => { el.hidden = (el.dataset.twinFlipLabel === 'back') !== on; });
      if (on && !editing() && matchMedia('(hover: hover)').matches) input.focus({ preventScroll: true });
    }
    flip.addEventListener('click', () => setFlipped(!root.classList.contains('flipped')));

    function bubble(role: Msg['role'], body = '') {
      const p = document.createElement('p');
      p.className = `twin-msg ${role === 'user' ? 'twin-me' : 'twin-ai'}`;
      p.textContent = body;
      log.append(p);
      log.scrollTop = log.scrollHeight;
      return p;
    }

    // Retro dialogue: reveal the reply a few letters at a time.
    function typeOut(el: HTMLElement, body: string) {
      if (reduced) { el.textContent = body; return Promise.resolve(); }
      return new Promise<void>((done) => {
        let i = 0;
        const tick = () => {
          i = Math.min(body.length, i + 2);
          el.textContent = body.slice(0, i);
          log.scrollTop = log.scrollHeight;
          if (i < body.length) setTimeout(tick, 18); else done();
        };
        setTimeout(tick, 250);
      });
    }

    async function ask(q: string, answer = match(q)) {
      if (!q || busy || editing()) return;
      busy = true;
      bubble('user', q);
      await typeOut(bubble('assistant'), answer);
      history.push({ role: 'user', content: q }, { role: 'assistant', content: answer });
      store.set(history);
      busy = false;
    }

    for (const m of history) bubble(m.role, m.content);

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const q = input.value.trim().slice(0, 300);
      if (busy || editing()) return;
      input.value = '';
      ask(q);
    });

    root.querySelectorAll<HTMLButtonElement>('[data-twin-ask]').forEach((b) => b.addEventListener('click', () => {
      const a = answers.find((x) => x.id === b.dataset.twinAsk);
      if (a) ask(b.textContent!.trim(), a.answer());
    }));

    root.querySelector('[data-twin-restart]')!.addEventListener('click', () => {
      if (editing() || busy) return;
      history = []; store.set(history);
      log.querySelectorAll('.twin-msg:not([data-edit])').forEach((el) => el.remove());
    });
  }
</script>
