---
interface Props { id: string; eyebrow: string; title: string; comingIn?: string }
const { id, eyebrow, title, comingIn } = Astro.props;
---
<section id={id} class="mx-auto max-w-6xl border-t border-line px-5 py-24 sm:px-8">
  <div class="reveal">
    <p class="mb-3 text-sm tracking-[0.2em] text-accent uppercase">{eyebrow}</p>
    <h2 class="font-serif text-4xl tracking-tight sm:text-5xl">{title}</h2>
    {comingIn && <p class="mt-3 text-sm text-muted">Coming in: {comingIn}</p>}
  </div>
  <div class="reveal mt-10"><slot /></div>
</section>
