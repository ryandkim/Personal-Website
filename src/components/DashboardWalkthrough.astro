---
// A guided tour of the recruiting and school dashboard: a pointer clicks
// through Home, Network and Jobs and types into the chat boxes. Visitors can
// also click the tabs and type themselves (nothing is saved or sent).
// Content: src/content/walkthroughs/networking-tracker.json (all made up).
import data from '../content/walkthroughs/networking-tracker.json';

const dot: Record<string, string> = { red: 'bg-red-400', orange: 'bg-orange-300', blue: 'bg-sky-400', green: 'bg-emerald-400' };
const pill: Record<string, string> = { red: 'bg-red-400/15 text-red-300', orange: 'bg-orange-300/15 text-orange-200', green: 'bg-emerald-400/15 text-emerald-300' };
const initials = (n: string) => n.split(' ').map((x) => x[0]).join('');
---
<section class="mt-14" data-tour aria-label={data.title}>
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div>
      <p class="text-xs tracking-[0.2em] text-accent uppercase">Walkthrough</p>
      <h2 class="mt-2 font-serif text-3xl">{data.title}</h2>
      <p class="mt-3 leading-relaxed text-muted">{data.intro}</p>
    </div>
    <button type="button" data-tour-play class="rounded-full bg-accent px-4 py-1.5 text-sm font-medium text-accent-ink hover:brightness-110">▶ Play tour</button>
  </div>

  <div class="tour-window relative mt-6 overflow-hidden rounded-2xl border border-line bg-panel">
    <div class="flex items-center gap-3 border-b border-line px-4 py-3">
      <span class="flex gap-1.5" aria-hidden="true"><i class="h-2.5 w-2.5 rounded-full bg-line"></i><i class="h-2.5 w-2.5 rounded-full bg-line"></i><i class="h-2.5 w-2.5 rounded-full bg-line"></i></span>
      <div class="flex gap-1" role="tablist" aria-label="Dashboard tabs">
        {['home', 'network', 'jobs'].map((id, i) => (
          <button type="button" role="tab" data-tour-tab={id} aria-selected={i === 0 ? 'true' : 'false'} class="tour-tab rounded-lg px-3 py-1 text-sm text-muted hover:text-text">
            {id === 'home' ? 'Home' : id === 'network' ? 'Network' : 'Jobs'}
          </button>
        ))}
      </div>
    </div>

    <div class="relative h-[30rem] overflow-hidden sm:h-[27rem]">
      <!-- Home -->
      <div class="tour-pane absolute inset-0 overflow-y-auto p-4 sm:p-5" data-pane="home">
        <div class="grid grid-cols-2 gap-3 lg:grid-cols-4">
          {data.home.kpis.map((k) => (
            <div class="rounded-xl bg-ink/50 p-3" data-kpi={k.label}>
              <p class="flex items-center gap-2 text-xs text-muted"><span class:list={['h-2 w-2 rounded-full', dot[k.tone]]}></span>{k.label}</p>
              <p class="mt-1 font-serif text-3xl" data-kpi-value>{k.value}</p>
              <p class="text-[11px] text-muted">{k.hint}</p>
            </div>
          ))}
        </div>
        <h3 class="mt-5 mb-2 text-xs tracking-widest text-accent uppercase">Top of the list today</h3>
        <ol class="space-y-2">
          {data.home.today.map((x) => (
            <li class="flex gap-3 rounded-xl bg-ink/40 p-3"><span class:list={['mt-1.5 h-2 w-2 shrink-0 rounded-full', dot[x.tone]]}></span><div><p class="text-sm">{x.title}</p><p class="text-xs text-muted">{x.meta}</p></div></li>
          ))}
        </ol>
      </div>

      <!-- Network -->
      <div class="tour-pane absolute inset-0 flex flex-col p-4 sm:p-5" data-pane="network" hidden>
        <h3 class="mb-2 text-xs tracking-widest text-accent uppercase">Follow-up queue</h3>
        <ol class="min-h-0 flex-1 space-y-2 overflow-y-auto" data-list>
          {data.network.rows.map((r) => (
            <li class="flex items-center gap-3 rounded-xl bg-ink/40 p-3">
              <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-accent/15 text-xs text-accent">{initials(r.name)}</span>
              <div class="min-w-0 flex-1"><p class="text-sm">{r.name} <span class="text-muted">· {r.org}</span></p><p class="truncate text-xs text-muted">Last talked {r.last} · {r.note}</p></div>
              <span class="hidden shrink-0 rounded-full border border-line px-2.5 py-1 text-xs sm:inline">Draft follow-up</span>
            </li>
          ))}
        </ol>
        <template data-new-row>
          <li class="tour-new flex items-center gap-3 rounded-xl border border-accent/40 bg-accent/5 p-3">
            <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-accent/15 text-xs text-accent">{initials(data.network.added.name)}</span>
            <div class="min-w-0 flex-1"><p class="text-sm">{data.network.added.name} <span class="text-muted">· {data.network.added.org}</span></p><p class="truncate text-xs text-muted">Added {data.network.added.last} · {data.network.added.note}</p></div>
            <span class="hidden shrink-0 text-xs text-accent sm:inline">New</span>
          </li>
        </template>
        <div class="tour-chat mt-3" data-chat="network" data-message={data.network.message} data-reply={data.network.reply}></div>
      </div>

      <!-- Jobs -->
      <div class="tour-pane absolute inset-0 flex flex-col p-4 sm:p-5" data-pane="jobs" hidden>
        <h3 class="mb-2 text-xs tracking-widest text-accent uppercase">Job application queue</h3>
        <ol class="min-h-0 flex-1 space-y-2 overflow-y-auto">
          {data.jobs.rows.map((j, i) => (
            <li class="tour-job flex items-center gap-3 rounded-xl bg-ink/40 p-3" data-job={i}>
              <div class="min-w-0 flex-1"><p class="text-sm">{j.title}</p><p class="truncate text-xs text-muted">{j.org}</p></div>
              <span class:list={['shrink-0 rounded-full px-2.5 py-1 text-xs', pill[j.urgency]]}>{j.left}</span>
              <label class="flex shrink-0 items-center gap-1.5 text-xs text-muted"><input type="checkbox" class="accent-[var(--color-accent)]" data-applied /> Applied</label>
            </li>
          ))}
        </ol>
        <div class="tour-chat mt-3" data-chat="jobs" data-message={data.jobs.message} data-reply={data.jobs.reply}></div>
      </div>

      <span class="tour-cursor pointer-events-none absolute top-0 left-0 z-10 hidden" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24"><path d="M4 2l16 9-7 2-3 7z" fill="#ecebe6" stroke="#0b0c0e" stroke-width="1.5" stroke-linejoin="round"/></svg>
      </span>
    </div>

    <p class="border-t border-line px-4 py-3 text-sm text-muted" data-caption aria-live="polite">{data.captions.home}</p>
  </div>
</section>

<style>
  .tour-tab[aria-selected='true'] { background: rgb(242 181 68 / .12); color: var(--color-text); }
  .tour-cursor { transition: transform .7s cubic-bezier(.4,.1,.2,1); }
  .tour-cursor.click svg { transform: scale(.82); transition: transform .12s; }
  .tour-new { animation: tour-in .5s ease; }
  .tour-pulse { box-shadow: 0 0 0 2px var(--color-accent); transition: box-shadow .3s; }
  @keyframes tour-in { from { opacity: 0; transform: translateY(-6px); } }
</style>

<script>
  import data from '../content/walkthroughs/networking-tracker.json';
  const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

  for (const root of document.querySelectorAll<HTMLElement>('[data-tour]')) {
    const stage = root.querySelector<HTMLElement>('.tour-window .relative')!;
    const cursor = root.querySelector<HTMLElement>('.tour-cursor')!;
    const caption = root.querySelector<HTMLElement>('[data-caption]')!;
    const caps = data.captions as Record<string, string>;
    let token = 0;

    // Chat boxes: a message thread plus an input. Visitors can type too.
    const chats: Record<string, { thread: HTMLElement; input: HTMLInputElement; send: HTMLButtonElement }> = {};
    for (const box of root.querySelectorAll<HTMLElement>('[data-chat]')) {
      box.innerHTML = `
        <div class="space-y-2 text-sm" data-thread></div>
        <form class="mt-2 flex gap-2">
          <input class="min-w-0 flex-1 rounded-full border border-line bg-ink px-4 py-2 text-sm outline-none placeholder:text-muted focus:border-accent/60"
            placeholder="${box.dataset.chat === 'network' ? 'Add a connection or note…' : 'Add a job or note…'}" aria-label="Message" />
          <button class="rounded-full bg-accent px-4 text-sm font-medium text-accent-ink">Send</button>
        </form>`;
      const thread = box.querySelector<HTMLElement>('[data-thread]')!;
      const input = box.querySelector('input')!;
      const send = box.querySelector('button')!;
      chats[box.dataset.chat!] = { thread, input, send };
      box.querySelector('form')!.addEventListener('submit', (e) => {
        e.preventDefault();
        if (!input.value.trim()) return;
        bubble(thread, input.value, 'me'); input.value = '';
        setTimeout(() => bubble(thread, 'This is a replay, so nothing is saved. In the real dashboard an agent files this for you.', 'bot'), 500);
      });
    }
    function bubble(thread: HTMLElement, text: string, who: 'me' | 'bot') {
      const p = document.createElement('p');
      p.className = who === 'me' ? 'tour-new ml-auto w-fit max-w-[85%] rounded-2xl bg-accent/15 px-3 py-2' : 'tour-new w-fit max-w-[85%] rounded-2xl bg-ink/60 px-3 py-2 text-muted';
      p.textContent = text; thread.append(p);
      while (thread.children.length > 2) thread.firstElementChild!.remove();
    }

    function show(id: string) {
      root.querySelectorAll<HTMLElement>('[data-pane]').forEach((p) => (p.hidden = p.dataset.pane !== id));
      root.querySelectorAll('[data-tour-tab]').forEach((t) => t.setAttribute('aria-selected', String((t as HTMLElement).dataset.tourTab === id)));
    }
    root.querySelectorAll<HTMLElement>('[data-tour-tab]').forEach((t) => t.addEventListener('click', (e) => {
      if (e.isTrusted) token++; // a real click stops the tour
      show(t.dataset.tourTab!); caption.textContent = caps[t.dataset.tourTab!];
    }));

    async function moveTo(el: Element, my: number) {
      const a = stage.getBoundingClientRect(), b = el.getBoundingClientRect();
      cursor.classList.remove('hidden');
      cursor.style.transform = `translate(${b.left - a.left + Math.min(b.width * 0.5, 40)}px, ${b.top - a.top + b.height * 0.55}px)`;
      await sleep(800);
      if (my !== token) throw 0;
    }
    async function click(el: HTMLElement, my: number) {
      await moveTo(el, my);
      cursor.classList.add('click'); await sleep(140); cursor.classList.remove('click');
      el.click();
      await sleep(250);
    }
    async function type(chat: { input: HTMLInputElement; send: HTMLButtonElement }, text: string, my: number) {
      await click(chat.input, my);
      for (const ch of text) { if (my !== token) throw 0; chat.input.value += ch; await sleep(28); }
      await sleep(300);
      await moveTo(chat.send, my);
    }
    const say = (k: string) => (caption.textContent = caps[k]);
    const tab = (id: string) => root.querySelector<HTMLElement>(`[data-tour-tab="${id}"]`)!;

    function reset() {
      show('home'); say('home');
      Object.values(chats).forEach((c) => { c.thread.innerHTML = ''; c.input.value = ''; });
      root.querySelectorAll('.tour-new').forEach((n) => n.remove());
      root.querySelectorAll<HTMLInputElement>('[data-applied]').forEach((c) => (c.checked = false));
      data.home.kpis.forEach((k) => (root.querySelector(`[data-kpi="${k.label}"] [data-kpi-value]`)!.textContent = k.value));
    }

    async function tour() {
      const my = ++token;
      reset();
      try {
        await sleep(2200);
        await click(tab('network'), my); say('network'); await sleep(2400);
        say('networkChat');
        const n = chats.network;
        await type(n, data.network.message, my);
        bubble(n.thread, n.input.value, 'me'); n.input.value = '';
        await sleep(700);
        bubble(n.thread, data.network.reply, 'bot');
        const tpl = root.querySelector<HTMLTemplateElement>('[data-new-row]')!;
        root.querySelector('[data-pane="network"] [data-list]')!.prepend(tpl.content.cloneNode(true));
        await sleep(3200);

        await click(tab('jobs'), my); say('jobs'); await sleep(2400);
        say('jobsChat');
        const j = chats.jobs;
        await type(j, data.jobs.message, my);
        bubble(j.thread, j.input.value, 'me'); j.input.value = '';
        await sleep(700);
        bubble(j.thread, data.jobs.reply, 'bot');
        const box = root.querySelector<HTMLInputElement>('[data-job="0"] [data-applied]')!;
        await click(box, my);
        await sleep(2600);

        await click(tab('home'), my); say('done');
        const set = (label: string, v: string) => { const el = root.querySelector(`[data-kpi="${label}"]`)!; el.querySelector('[data-kpi-value]')!.textContent = v; el.classList.add('tour-pulse'); setTimeout(() => el.classList.remove('tour-pulse'), 1200); };
        set('Apply soon', '1'); await sleep(400); set('Contacts', '49'); await sleep(400); set('Drafts in Gmail', '3');
        await sleep(1000);
        cursor.classList.add('hidden');
      } catch { cursor.classList.add('hidden'); }
    }

    root.querySelector('[data-tour-play]')!.addEventListener('click', tour);
    // Start the tour the first time it scrolls into view (unless reduced motion).
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const io = new IntersectionObserver((es) => { if (es.some((e) => e.isIntersecting)) { io.disconnect(); tour(); } }, { threshold: 0.5 });
      io.observe(root.querySelector('.tour-window')!);
    }
  }
</script>
