---
// A slowly turning 3D mannequin wearing each suggested outfit. The product
// cut-outs are wrapped onto the body; every full turn the next pick becomes the
// main pick and the clothes change with it. Click a pick to jump to it.
import type { OutfitPick } from '../lib/demos';
interface Props { picks: OutfitPick[] }
const { picks } = Astro.props;
---
<div class="wardrobe grid gap-4 sm:grid-cols-[minmax(0,5fr)_minmax(0,6fr)]" data-wardrobe data-picks={JSON.stringify(picks)}>
  <div class="relative aspect-[3/4] max-h-[28rem] w-full overflow-hidden rounded-xl bg-[radial-gradient(60%_50%_at_50%_40%,rgb(242_181_68/0.10),transparent)]">
    <canvas class="absolute inset-0 h-full w-full" aria-label="3D mannequin wearing the main pick" role="img"></canvas>
    <p class="pointer-events-none absolute inset-x-0 top-3 text-center text-[11px] tracking-widest text-muted uppercase">Main pick: <span class="text-text" data-label>{picks[0]?.title}</span></p>
  </div>
  <ol class="space-y-2" aria-label="Outfit picks">
    {picks.map((p, i) => (
      <li>
        <button type="button" data-pick={i} aria-pressed={i === 0 ? 'true' : 'false'} class="wardrobe-pick w-full rounded-xl border border-line bg-ink/40 p-3 text-left transition">
          <p class="flex items-baseline justify-between gap-2 text-[11px] tracking-wider text-muted uppercase"><span>{p.meta}</span><span class="wardrobe-now hidden text-accent">Main pick</span></p>
          <p class="mt-0.5 font-serif text-lg">{p.title}</p>
          {p.body && <p class="mt-1 text-sm leading-relaxed text-muted">{p.body}</p>}
          <ul class="mt-2 flex flex-wrap gap-1.5">
            {p.items.map((it) => (
              <li class="flex items-center gap-1.5 rounded-full bg-panel px-2 py-0.5 text-xs">
                {it.img ? <img src={it.img} alt="" class="h-4 w-4 object-contain" loading="lazy" /> : <span class="h-3 w-3 rounded-full border border-white/20" style={`background:${it.color}`}></span>}
                {it.label}
              </li>
            ))}
          </ul>
        </button>
      </li>
    ))}
  </ol>
</div>

<style>
  .wardrobe-pick[aria-pressed='true'] { border-color: var(--color-accent); background: rgb(242 181 68 / .06); }
  .wardrobe-pick[aria-pressed='true'] .wardrobe-now { display: inline; }
</style>

<script>
  import type { OutfitPick, OutfitItem } from '../lib/demos';

  const TURN_SECONDS = 9; // one full turn per pick

  async function mount(root: HTMLElement) {
    const THREE = await import('three');
    const picks: OutfitPick[] = JSON.parse(root.dataset.picks!);
    const canvas = root.querySelector('canvas')!;
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-pick]')];
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
    renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
    renderer.outputColorSpace = THREE.SRGBColorSpace;
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(28, 3 / 4, 0.1, 20);
    camera.position.set(0, 0.95, 3.9);
    camera.lookAt(0, 0.88, 0);

    scene.add(new THREE.HemisphereLight(0xfff6e8, 0x1a1c20, 1.3));
    const key = new THREE.DirectionalLight(0xffffff, 1.6); key.position.set(1.5, 2.5, 3); scene.add(key);
    const rim = new THREE.DirectionalLight(0xf2b544, 1.1); rim.position.set(-2, 1.8, -2.5); scene.add(rim);

    const floor = new THREE.Mesh(new THREE.CircleGeometry(0.55, 48), new THREE.MeshBasicMaterial({ color: 0xf2b544, transparent: true, opacity: 0.08 }));
    floor.rotation.x = -Math.PI / 2; scene.add(floor);

    // ---- mannequin (a simple, faceless form)
    const figure = new THREE.Group(); scene.add(figure);
    const skin = new THREE.MeshStandardMaterial({ color: 0xcfc8bd, roughness: 0.55, metalness: 0.05 });
    const add = (geo: THREE.BufferGeometry, x: number, y: number, z = 0, rz = 0) => {
      const m = new THREE.Mesh(geo, skin); m.position.set(x, y, z); m.rotation.z = rz; figure.add(m); return m;
    };
    add(new THREE.SphereGeometry(0.105, 32, 24), 0, 1.68).scale.set(0.9, 1.1, 1);
    add(new THREE.CylinderGeometry(0.045, 0.05, 0.12, 16), 0, 1.55);
    const torsoPts = [[0, 0.93], [0.15, 0.94], [0.155, 1.02], [0.145, 1.12], [0.165, 1.28], [0.19, 1.41], [0.17, 1.47], [0.07, 1.52], [0, 1.53]]
      .map(([r, y]) => new THREE.Vector2(r, y));
    add(new THREE.LatheGeometry(torsoPts, 40), 0, 0).scale.set(1, 1, 0.68);
    for (const s of [-1, 1]) {
      const arm = new THREE.Mesh(new THREE.CapsuleGeometry(0.042, 0.5, 6, 16), skin);
      arm.geometry.translate(0, -0.29, 0);
      arm.position.set(s * 0.2, 1.45, 0); arm.rotation.z = s * 0.32; figure.add(arm);
      add(new THREE.CapsuleGeometry(0.062, 0.74, 6, 16), s * 0.085, 0.52);
    }

    // ---- clothes, rebuilt for each pick
    const loader = new THREE.TextureLoader();
    const cache = new Map<string, Promise<THREE.Texture>>();
    const tex = (url: string) => {
      if (!cache.has(url)) cache.set(url, loader.loadAsync(url).then((t) => { t.colorSpace = THREE.SRGBColorSpace; t.anisotropy = 4; return t; }));
      return cache.get(url)!;
    };
    let outfit = new THREE.Group(); figure.add(outfit);

    // Wrap a cut-out around the body: one half-cylinder in front, one behind.
    function shell(t: THREE.Texture, rTop: number, rBottom: number, top: number, h: number, depth = 0.72, order = 1) {
      const g = new THREE.Group();
      const mat = new THREE.MeshStandardMaterial({ map: t, alphaTest: 0.45, roughness: 0.8 });
      for (const start of [-Math.PI / 2, Math.PI / 2]) {
        const m = new THREE.Mesh(new THREE.CylinderGeometry(rTop, rBottom, h, 40, 1, true, start, Math.PI), mat);
        m.renderOrder = order; g.add(m);
      }
      g.position.y = top - h / 2; g.scale.z = depth;
      return g;
    }
    const aspect = (t: THREE.Texture) => (t.image as HTMLImageElement).height / (t.image as HTMLImageElement).width;
    const clamp = (v: number, a: number, b: number) => Math.min(b, Math.max(a, v));

    async function dress(p: OutfitPick) {
      const next = new THREE.Group();
      const parts = await Promise.all(p.items.map(async (it: OutfitItem) => ({ it, t: it.img ? await tex(it.img) : null })));
      for (const { it, t } of parts) {
        if (it.slot === 'top' || it.slot === 'outer') {
          const r = it.slot === 'outer' ? 0.235 : 0.215;
          if (t) next.add(shell(t, r + 0.03, r - 0.02, 1.53, clamp(Math.PI * r * aspect(t), 0.48, 0.78), 0.72, it.slot === 'outer' ? 3 : 2));
          else next.add(shell(solid(it.color), r + 0.03, r - 0.02, 1.53, 0.6, 0.72, 2));
        } else if (it.slot === 'bottom') {
          const h = it.fit === 'short' ? 0.42 : t ? clamp(Math.PI * 0.17 * aspect(t), 0.5, 0.98) : 0.9;
          next.add(shell(t ?? solid(it.color), 0.175, 0.15, 1.0, h, 0.78, 1));
        } else if (it.slot === 'shoes') {
          for (const s of [-1, 1]) next.add(shoe(it, t, s));
        }
      }
      figure.remove(outfit); outfit = next; figure.add(outfit);
    }
    function solid(color: string) {
      const c = document.createElement('canvas'); c.width = c.height = 4;
      const x = c.getContext('2d')!; x.fillStyle = color; x.fillRect(0, 0, 4, 4);
      const t = new THREE.CanvasTexture(c); t.colorSpace = THREE.SRGBColorSpace; return t;
    }
    function shoe(it: OutfitItem, t: THREE.Texture | null, s: number) {
      const g = new THREE.Group(); g.position.set(s * 0.09, 0, 0.05);
      const base = new THREE.MeshStandardMaterial({ color: new THREE.Color(it.color), roughness: 0.6 });
      const top = t && it.view === 'top' ? new THREE.MeshStandardMaterial({ map: t, alphaTest: 0.3, roughness: 0.6 }) : base;
      // Box faces: +x, -x, +y, -y, +z, -z. A top-down photo goes on the top face.
      const box = new THREE.Mesh(new THREE.BoxGeometry(0.09, 0.06, 0.24), [base, base, top, base, base, base]);
      box.position.y = 0.03; g.add(box);
      if (t && it.view !== 'top') {
        // A side-view photo: a cut-out on each side of the foot.
        const w = 0.28, h = w * aspect(t);
        const mat = new THREE.MeshStandardMaterial({ map: t, alphaTest: 0.4, side: THREE.DoubleSide, roughness: 0.6 });
        for (const dir of [-1, 1]) {
          const plane = new THREE.Mesh(new THREE.PlaneGeometry(w, h), mat);
          plane.rotation.y = (dir * Math.PI) / 2; plane.position.set(dir * 0.048, h / 2, 0); g.add(plane);
        }
      }
      return g;
    }

    // ---- size + loop
    const resize = () => {
      const { clientWidth: w, clientHeight: h } = canvas;
      if (!w || !h) return;
      renderer.setSize(w, h, false); camera.aspect = w / h; camera.updateProjectionMatrix();
    };
    new ResizeObserver(resize).observe(canvas); resize();

    let current = 0;
    const select = (i: number) => {
      current = (i + picks.length) % picks.length;
      buttons.forEach((b, j) => b.setAttribute('aria-pressed', String(j === current)));
      root.querySelector('[data-label]')!.textContent = picks[current].title;
      return dress(picks[current]);
    };
    buttons.forEach((b, i) => b.addEventListener('click', () => { select(i); angle = 0; }));
    await select(0);

    let angle = 0, last = performance.now(), visible = true;
    new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(canvas);
    const speed = (Math.PI * 2) / TURN_SECONDS;
    function frame(now: number) {
      const dt = Math.min(0.05, (now - last) / 1000); last = now;
      if (visible && !document.hidden && root.offsetParent) {
        if (!reduce) {
          const before = angle;
          angle += dt * speed;
          // Swap outfits while the mannequin faces away, so the change is smooth.
          if (before < Math.PI && angle >= Math.PI) select(current + 1);
          if (angle >= Math.PI * 2) angle -= Math.PI * 2;
        }
        figure.rotation.y = reduce ? 0.35 : angle;
        renderer.render(scene, camera);
      }
      requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
  }

  // Load three.js only when a mannequin is about to be seen.
  for (const root of document.querySelectorAll<HTMLElement>('[data-wardrobe]')) {
    const io = new IntersectionObserver((es) => {
      if (es.some((e) => e.isIntersecting)) { io.disconnect(); mount(root); }
    }, { rootMargin: '200px' });
    io.observe(root);
  }
</script>
