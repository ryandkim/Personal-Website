---
// Small cover card for a Beyond-work category. Clicking it opens a full-size,
// swipeable gallery (with sound for videos) in a pop-up. If the item on the
// card is a video, clicking plays it right in the card with sound instead,
// with Full screen / Open gallery / Stop buttons underneath.
import Carousel from './Carousel.astro';
import MediaSlide from './MediaSlide.astro';
import type { MediaItem } from '../data/media';
interface Props { id: string; index: number; title: string; blurb: string; items: MediaItem[] }
const { id, index, title, blurb, items } = Astro.props;
---
<div id={id} data-gallery-card>
  <!-- With several items: arrows flip through them in place, and the next ones peek out on the right like a deck of cards. -->
  <!-- Every card keeps the same right margin (where the deck peeks out), so all boxes are the same size and the titles line up. -->
  <div class="group relative pr-5">
    <button type="button" data-open-gallery={`gallery-${id}`} aria-haspopup="dialog"
      class="relative block w-full cursor-pointer text-left transition duration-300 hover:-translate-y-1 focus-visible:-translate-y-1">
      <div class="relative aspect-square">
        {items.map((item, i) => (
          <div data-deck-card={i} data-kind={item.type} data-yt={item.type === 'youtube' ? item.id : undefined}
            data-src={item.type === 'video' ? item.src : undefined} aria-hidden={i === 0 ? undefined : 'true'}
            class="absolute inset-0 origin-right transition-[transform,opacity,filter] duration-300 ease-out"
            style={i === 0 ? 'z-index:30' : i === 1 ? 'z-index:20;transform:translateX(10px) scale(.94);filter:brightness(.5)' : i === 2 ? 'z-index:10;transform:translateX(20px) scale(.88);filter:brightness(.3)' : 'z-index:0;opacity:0'}>
            <MediaSlide item={item} mode="preview" aspect="aspect-square" />
            {(item.caption || item.date) && (
              <div class="pointer-events-none absolute inset-x-0 bottom-0 rounded-b-2xl bg-gradient-to-t from-black/85 via-black/50 to-transparent px-4 pt-10 pb-4">
                {item.date && <span class="block text-[11px] tracking-widest text-accent uppercase">{item.date}</span>}
                {item.caption && <span class="line-clamp-2 text-sm leading-snug text-white">{item.caption}</span>}
              </div>
            )}
          </div>
        ))}
      </div>
      <span data-deck-count class="absolute top-3 right-3 z-40 rounded-full bg-black/60 px-2.5 py-1 text-[11px] text-white backdrop-blur">
        {items.length > 1 ? `1 / ${items.length}` : `${items.length} ${items.length === 1 ? 'item' : 'items'}`}
      </span>
      <span data-deck-hint class="absolute top-3 left-3 z-40 rounded-full bg-black/60 px-3 py-1.5 text-center text-xs text-white opacity-0 backdrop-blur transition group-hover:opacity-100 group-focus-within:opacity-100">
        Open gallery
      </span>
    </button>
    <!-- A video on the front card plays right here when the card is clicked (see the script below). -->
    <div data-player hidden class:list={['absolute inset-y-0 left-0 z-[35] overflow-hidden rounded-2xl border border-line bg-black', 'right-5']}></div>
    {items.length > 1 && (
      <>
        <button type="button" data-deck-prev aria-label={`Previous ${title} item`}
          class="absolute top-1/2 left-2 z-40 grid h-9 w-9 -translate-y-1/2 place-items-center rounded-full bg-black/35 text-lg text-white/80 backdrop-blur-sm transition hover:bg-black/55 hover:text-white">‹</button>
        <button type="button" data-deck-next aria-label={`Next ${title} item`}
          class="absolute top-1/2 right-7 z-40 grid h-9 w-9 -translate-y-1/2 place-items-center rounded-full bg-black/35 text-lg text-white/80 backdrop-blur-sm transition hover:bg-black/55 hover:text-white">›</button>
      </>
    )}
  </div>
  <div data-player-bar hidden class="mt-3 flex gap-2 text-xs">
    <button type="button" data-player-full class="rounded-full border border-line px-3 py-1.5 text-muted transition hover:border-text hover:text-text">⛶ Full screen</button>
    <button type="button" data-player-gallery class="rounded-full border border-line px-3 py-1.5 text-muted transition hover:border-text hover:text-text">Open gallery</button>
    <button type="button" data-player-stop class="rounded-full border border-line px-3 py-1.5 text-muted transition hover:border-text hover:text-text">Stop</button>
  </div>
  <h3 class="mt-4 font-serif text-2xl" data-edit={`beyond.${id}.title`}>{title}</h3>
  <p class="mt-1 text-sm text-muted" data-edit={`beyond.${id}.blurb`}>{blurb}</p>

  <dialog id={`gallery-${id}`} aria-label={`${title} gallery`}
    class="m-auto w-[min(92vw,640px)] overflow-visible bg-transparent p-0 text-text backdrop:bg-black/80 backdrop:backdrop-blur-sm">
    <div class="rounded-3xl border border-line bg-ink p-4 sm:p-6">
      <div class="mb-4 flex items-start justify-between gap-4">
        <div>
          <h3 class="font-serif text-2xl">{title}</h3>
          <p class="text-sm text-muted">{blurb}</p>
        </div>
        <button type="button" data-close aria-label="Close gallery"
          class="grid h-9 w-9 shrink-0 place-items-center rounded-full border border-line text-muted transition hover:border-text hover:text-text">✕</button>
      </div>
      <Carousel label={title} count={items.length} captions>
        {items.map((item, i) => (
          <div class="flex w-full shrink-0 snap-center justify-center">
            <div class="w-[min(100%,calc(68vh*0.8))]"><MediaSlide item={item} editKey={`media:beyond.${index}.items.${i}`} /></div>
          </div>
        ))}
      </Carousel>
      <button type="button" data-media-add data-media-list={`beyond.${index}`}
          class="media-pick mt-3 items-center gap-1.5 rounded-full border border-accent/60 px-4 py-2 text-sm text-accent hover:bg-accent/10"><span aria-hidden="true">＋</span>Add more photos/videos</button>
    </div>
  </dialog>
</div>

<script>
  // Flip through a card's items with its arrows, without opening the gallery.
  // The current item sits on top; the next two peek out on the right, smaller and darker.
  const LAYERS = [
    { z: 30, t: 'none', f: 'none', o: '1' },
    { z: 20, t: 'translateX(10px) scale(.94)', f: 'brightness(.5)', o: '1' },
    { z: 10, t: 'translateX(20px) scale(.88)', f: 'brightness(.3)', o: '1' },
  ];
  document.querySelectorAll<HTMLElement>('[data-gallery-card]').forEach((card) => {
    const cards = Array.from(card.querySelectorAll<HTMLElement>('[data-deck-card]'));
    const count = card.querySelector<HTMLElement>('[data-deck-count]');
    const hint = card.querySelector<HTMLElement>('[data-deck-hint]');
    const player = card.querySelector<HTMLElement>('[data-player]')!;
    const bar = card.querySelector<HTMLElement>('[data-player-bar]')!;
    const openBtn = card.querySelector<HTMLButtonElement>('[data-open-gallery]')!;
    let at = 0;

    // ---- Play a video in the card ----
    const playable = (el?: HTMLElement) => !!el && ((el.dataset.kind === 'youtube' && !!el.dataset.yt) || (el.dataset.kind === 'video' && !!el.dataset.src));
    const updateHint = () => { if (hint) hint.textContent = playable(cards[at]) ? '▶ Play video' : 'Open gallery'; };
    // The hover hint is hidden while a video plays (it flickered over the player).
    const stop = () => { player.replaceChildren(); player.hidden = true; bar.hidden = true; if (hint) hint.hidden = false; openBtn.style.transform = ''; };
    const play = (el: HTMLElement) => {
      let media: HTMLElement;
      if (el.dataset.kind === 'youtube') {
        const f = document.createElement('iframe');
        f.src = `https://www.youtube-nocookie.com/embed/${el.dataset.yt}?autoplay=1&playsinline=1&rel=0`;
        f.title = 'Video';
        f.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; fullscreen';
        f.allowFullscreen = true;
        media = f;
      } else {
        const v = Object.assign(document.createElement('video'), { src: el.dataset.src!, controls: true, autoplay: true, playsInline: true });
        v.play().catch(() => {});
        media = v;
      }
      media.className = 'h-full w-full bg-black object-contain';
      player.replaceChildren(media);
      player.hidden = false;
      bar.hidden = false;
      if (hint) hint.hidden = true;
      openBtn.style.transform = 'none'; // no hover lift under the player, which made it jump
    };
    // Capture phase, so this runs before the gallery opens.
    openBtn.addEventListener('click', (e) => {
      if (!playable(cards[at]) || document.body.classList.contains('editing')) return; // edit mode opens the gallery
      e.preventDefault();
      e.stopImmediatePropagation();
      play(cards[at]);
    }, true);
    card.querySelector('[data-player-stop]')!.addEventListener('click', stop);
    card.querySelector('[data-player-gallery]')!.addEventListener('click', () => { stop(); openBtn.dispatchEvent(new CustomEvent('open-gallery')); });
    card.querySelector('[data-player-full]')!.addEventListener('click', () => {
      const m = player.firstElementChild as (HTMLElement & { webkitEnterFullscreen?: () => void }) | null;
      if (!m) return;
      if (m.requestFullscreen) m.requestFullscreen().catch(() => m.webkitEnterFullscreen?.());
      else m.webkitEnterFullscreen?.();
    });
    updateHint();
    if (cards.length < 2) return;

    const show = (i: number) => {
      stop();
      at = (i + cards.length) % cards.length;
      card.dataset.deckAt = String(at);
      cards.forEach((el, j) => {
        const d = (j - at + cards.length) % cards.length;
        const l = LAYERS[d];
        el.style.zIndex = String(l ? l.z : 0);
        el.style.transform = l ? l.t : 'translateX(20px) scale(.88)';
        el.style.filter = l ? l.f : 'brightness(.3)';
        el.style.opacity = l ? l.o : '0';
        el.toggleAttribute('aria-hidden', d !== 0);
        if (d !== 0) el.querySelectorAll('video').forEach((v) => v.pause());
      });
      if (count) count.textContent = `${at + 1} / ${cards.length}`;
      updateHint();
    };
    card.querySelector('[data-deck-prev]')?.addEventListener('click', () => show(at - 1));
    card.querySelector('[data-deck-next]')?.addEventListener('click', () => show(at + 1));
  });

  // Open on card click; close on ✕, Esc, or clicking outside. Stop any sound on close.
  document.querySelectorAll<HTMLButtonElement>('[data-open-gallery]').forEach((btn) => {
    const dlg = document.getElementById(btn.dataset.openGallery!) as HTMLDialogElement;
    const open = () => {
      dlg.showModal();
      document.documentElement.style.overflow = 'hidden';
      // Open on the item showing on the card.
      const at = Number(btn.closest<HTMLElement>('[data-gallery-card]')?.dataset.deckAt ?? 0);
      const track = dlg.querySelector<HTMLElement>('[data-track]');
      const slide = track?.children[at] as HTMLElement | undefined;
      if (track && slide) { track.style.scrollBehavior = 'auto'; track.scrollLeft = slide.offsetLeft - track.offsetLeft; track.style.scrollBehavior = ''; }
      window.dispatchEvent(new Event('resize')); // let the carousel recompute its arrows
    };
    btn.addEventListener('click', open);
    btn.addEventListener('open-gallery', open);
    dlg.querySelector('[data-close]')!.addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    dlg.addEventListener('close', () => {
      document.documentElement.style.overflow = '';
      dlg.querySelectorAll('video').forEach((v) => v.pause());
      dlg.querySelectorAll('iframe').forEach((f) => { const s = f.src; f.src = s; });
    });
  });
</script>
