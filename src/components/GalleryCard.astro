---
// Small cover card for a Beyond-work category. Clicking it opens a full-size,
// swipeable gallery (with sound for videos) in a pop-up.
import Carousel from './Carousel.astro';
import MediaSlide from './MediaSlide.astro';
import type { MediaItem } from '../data/media';
interface Props { id: string; index: number; title: string; blurb: string; items: MediaItem[] }
const { id, index, title, blurb, items } = Astro.props;
const cover = items[0];
---
<div id={id}>
  <button type="button" data-open-gallery={`gallery-${id}`} aria-haspopup="dialog"
    class="group block w-full cursor-pointer text-left">
    <div class="relative transition duration-300 group-hover:-translate-y-1">
      {cover && <MediaSlide item={cover} mode="preview" aspect="aspect-square" />}
      <span class="absolute top-3 right-3 rounded-full bg-black/60 px-2.5 py-1 text-[11px] text-white backdrop-blur">
        {items.length} {items.length === 1 ? 'item' : 'items'}
      </span>
      <span class="absolute inset-x-3 bottom-3 rounded-full bg-black/60 px-3 py-1.5 text-center text-xs text-white opacity-0 backdrop-blur transition group-hover:opacity-100 group-focus-visible:opacity-100">
        Open gallery
      </span>
    </div>
  </button>
  <h3 class="mt-4 font-serif text-2xl" data-edit={`beyond.${id}.title`}>{title}</h3>
  <p class="mt-1 text-sm text-muted" data-edit={`beyond.${id}.blurb`}>{blurb}</p>

  <dialog id={`gallery-${id}`} aria-label={`${title} gallery`}
    class="m-auto w-[min(92vw,640px)] overflow-visible bg-transparent p-0 text-text backdrop:bg-black/80 backdrop:backdrop-blur-sm">
    <div class="rounded-3xl border border-line bg-ink p-4 sm:p-6">
      <div class="mb-4 flex items-start justify-between gap-4">
        <div>
          <h3 class="font-serif text-2xl">{title}</h3>
          <p class="text-sm text-muted">{blurb}</p>
        </div>
        <button type="button" data-close aria-label="Close gallery"
          class="grid h-9 w-9 shrink-0 place-items-center rounded-full border border-line text-muted transition hover:border-text hover:text-text">✕</button>
      </div>
      <Carousel label={title} count={items.length} captions>
        {items.map((item, i) => (
          <div class="flex w-full shrink-0 snap-center justify-center">
            <div class="w-[min(100%,calc(68vh*0.8))]"><MediaSlide item={item} editKey={`media:beyond.${index}.items.${i}`} /></div>
          </div>
        ))}
      </Carousel>
    </div>
  </dialog>
</div>

<script>
  // Open on card click; close on ✕, Esc, or clicking outside. Stop any sound on close.
  document.querySelectorAll<HTMLButtonElement>('[data-open-gallery]').forEach((btn) => {
    const dlg = document.getElementById(btn.dataset.openGallery!) as HTMLDialogElement;
    btn.addEventListener('click', () => {
      dlg.showModal();
      document.documentElement.style.overflow = 'hidden';
      window.dispatchEvent(new Event('resize')); // let the carousel recompute its arrows
    });
    dlg.querySelector('[data-close]')!.addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    dlg.addEventListener('close', () => {
      document.documentElement.style.overflow = '';
      dlg.querySelectorAll('video').forEach((v) => v.pause());
      dlg.querySelectorAll('iframe').forEach((f) => { const s = f.src; f.src = s; });
    });
  });
</script>
