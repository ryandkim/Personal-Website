---
interface Props { label: string; editKey?: string }
const { label, editKey } = Astro.props;
---
<div class="rounded-2xl border border-dashed border-line bg-panel/50 p-8 text-muted">
  <p class="text-xs tracking-widest text-accent/80 uppercase">Placeholder</p>
  <p class="mt-2" data-edit={editKey}>{label}</p>
  <slot />
</div>
