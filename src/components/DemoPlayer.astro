---
// Replays a saved agent run step by step, then shows the result.
// Data: src/content/demos/<slug>.json (see src/lib/demos.ts). Zero AI calls.
import type { Demo, DemoBlock } from '../lib/demos';
import { content } from '../data/site';
import WardrobeAvatar from './WardrobeAvatar.astro';

interface Props { demo: Demo; slug: string }
const { demo, slug } = Astro.props;
const wide = demo.layout === 'wide';
const MAX = 5; // longer lists collapse behind "See more"
const t = content.ui.demo;
const k = (f: string) => `ui.demo.${f}`;

// Wardrobe colors come as plain words; map the ones CSS doesn't know.
const swatch: Record<string, string> = { charcoal: '#36454f', cream: '#f3ecd8', khaki: '#c3b091', camel: '#c19a6b', denim: '#3b5b84', 'light blue': '#add8e6', 'off-white': '#f4f1ea' };
const color = (c?: string | null) => (c ? swatch[c.toLowerCase()] ?? c.toLowerCase().replace(/\s+/g, '') : 'transparent');
const tone: Record<string, string> = { red: 'bg-red-400', orange: 'bg-orange-300', blue: 'bg-sky-400', green: 'bg-emerald-400' };
const fmtDate = (d: string) => new Date(`${d}T12:00:00`).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
const blockTitle = (b: DemoBlock) => ('title' in b ? b.title : undefined);
---
<section class="demo" data-demo data-slug={slug} aria-label={demo.title}>
  <header>
      <p class="text-xs tracking-[0.2em] text-accent uppercase">
        <span data-edit={k('eyebrow')}>{t.eyebrow}</span>
        {demo.sample && <span class="ml-2 rounded-full border border-accent/40 px-2 py-0.5 text-[10px] tracking-widest" data-edit={k('sampleBadge')}>{t.sampleBadge}</span>}
      </p>
      <h2 class="mt-2 font-serif text-3xl">{demo.title}</h2>
      <p class="mt-3 leading-relaxed text-muted">{demo.intro}</p>
  </header>

  {demo.scenarios.length > 1 && (
    <div class="mt-6 flex flex-wrap gap-2" role="tablist" aria-label="Scenarios">
      {demo.scenarios.map((s, i) => (
        <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-tab={i}
          class="demo-tab rounded-full border border-line px-4 py-1.5 text-sm text-muted transition hover:text-text">{s.label}</button>
      ))}
    </div>
  )}

  {demo.scenarios.map((s, si) => (
    <div class="demo-run mt-4 overflow-hidden rounded-2xl border border-line bg-panel" data-run={si} hidden={si !== 0}>
      <div class="flex items-center gap-3 border-b border-line px-4 py-3">
        <span class="flex gap-1.5" aria-hidden="true"><i class="h-2.5 w-2.5 rounded-full bg-line"></i><i class="h-2.5 w-2.5 rounded-full bg-line"></i><i class="h-2.5 w-2.5 rounded-full bg-line"></i></span>
        <p class="min-w-0 flex-1 truncate font-mono text-xs text-muted">{slug} · {s.prompt ?? s.label}</p>
          <div class="flex shrink-0 gap-2">
            <button type="button" data-play class="rounded-full bg-accent px-3 py-1 text-xs font-medium text-accent-ink hover:brightness-110"><span data-edit={k('play')}>{t.play}</span></button>
            <button type="button" data-skip class="rounded-full border border-line px-3 py-1 text-xs hover:border-accent/60"><span data-edit={k('skip')}>{t.skip}</span></button>
          </div>
      </div>

      <div class:list={['grid', !wide && 'md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]']}>
        <ol class:list={['gap-3 border-b border-line p-4 sm:p-5', wide ? 'grid sm:grid-cols-2 lg:grid-cols-4' : 'grid md:border-r md:border-b-0']} aria-label="Agent steps">
          {s.steps.map((st) => (
            <li class="demo-step flex gap-3" data-ms={st.ms ?? ''} data-status={st.status ?? 'ok'}>
              <span class="demo-icon mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full border border-line text-[11px]" aria-hidden="true"></span>
              <div class="min-w-0">
                <p class="font-mono text-[11px] text-accent">{st.tool}{st.ms ? <span class="text-muted"> · {st.ms < 1000 ? `${st.ms} ms` : `${(st.ms / 1000).toFixed(1)} s`}</span> : null}</p>
                <p class="text-sm break-words">{st.label}</p>
                {st.detail && <p class="text-xs text-muted">{st.detail}</p>}
                {st.lines?.map((l) => <p class:list={['demo-line font-mono text-xs break-words', st.status === 'block' ? 'text-red-300' : 'text-emerald-300']}>{l}</p>)}
              </div>
            </li>
          ))}
        </ol>

        <div class="demo-result relative min-h-48 space-y-6 p-4 sm:p-5" data-result>
          <p class="demo-waiting absolute inset-0 grid place-items-center text-sm text-muted" data-edit={k('waiting')}>{t.waiting}</p>
          {s.result.map((b) => (
            <div class="demo-block">
              {blockTitle(b) && <h3 class="mb-3 text-xs tracking-widest text-accent uppercase">{blockTitle(b)}</h3>}
              {b.type === 'stats' && (
                <dl class="grid grid-cols-3 gap-3">
                  {b.items.map((x) => <div class="rounded-xl bg-ink/60 p-3"><dt class="text-[11px] text-muted">{x.label}</dt><dd class="mt-1 font-serif text-2xl">{x.value}</dd></div>)}
                </dl>
              )}
              {b.type === 'bullets' && (
                <ul class="space-y-2">{b.items.map((x) => <li class="flex gap-3 text-sm leading-relaxed"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"></span>{x}</li>)}</ul>
              )}
              {b.type === 'table' && (
                <div class="overflow-x-auto">
                  <table class="w-full text-sm">
                    <thead><tr>{b.columns.map((c, i) => <th class:list={['pb-2 text-left text-[11px] font-normal text-muted', i === b.columns.length - 1 && 'text-right']}>{c}</th>)}</tr></thead>
                    <tbody>{b.rows.map((r) => <tr class="border-t border-line">{r.map((c, i) => {
                      const v = typeof c === 'string' ? c : c.v;
                      const tn = typeof c === 'string' ? undefined : c.tone;
                      return <td class:list={['py-1.5', i === 0 && 'font-mono text-xs', i === r.length - 1 && 'text-right tabular-nums', tn === 'up' && 'text-emerald-300', tn === 'down' && 'text-red-300']}>{v}</td>;
                    })}</tr>)}</tbody>
                  </table>
                </div>
              )}
              {b.type === 'cards' && (
                <div class="grid gap-3">
                  {b.items.map((x) => (
                    <div class="rounded-xl border border-line bg-ink/40 p-4">
                      {x.meta && <p class="text-[11px] tracking-wider text-muted uppercase">{x.meta}</p>}
                      <p class="mt-0.5 font-serif text-lg">{x.href ? <a href={x.href} target="_blank" rel="noopener" class="hover:text-accent">{x.title} ↗</a> : x.title}</p>
                      {x.body && <p class="mt-1 text-sm leading-relaxed text-muted">{x.body}</p>}
                      {x.chips && (
                        <ul class="mt-3 flex flex-wrap gap-2">{x.chips.map((c) => (
                          <li class="flex items-center gap-1.5 rounded-full bg-panel px-2.5 py-1 text-xs"><span class="h-3 w-3 rounded-full border border-white/20" style={`background:${color(c.color)}`}></span>{c.label}</li>
                        ))}</ul>
                      )}
                    </div>
                  ))}
                </div>
              )}
              {b.type === 'list' && (
                <ol class="space-y-2">
                  {b.items.map((x, i) => (
                    <li class:list={['flex gap-3 rounded-xl bg-ink/40 p-3', i >= MAX && 'demo-more']} hidden={i >= MAX}>
                      <span class:list={['mt-1.5 h-2 w-2 shrink-0 rounded-full', tone[x.tone ?? 'blue']]}></span>
                      <div class="min-w-0 flex-1">
                        <div class="flex flex-wrap items-baseline justify-between gap-x-3">
                          <p class="text-sm break-words">{x.title}</p>
                          {x.badge && <span class="shrink-0 text-[11px] text-muted">{x.badge}</span>}
                        </div>
                        {x.meta && <p class="text-xs text-muted">{x.meta}</p>}
                        {x.detail && <p class="mt-1 text-xs leading-relaxed text-muted/80">{x.detail}</p>}
                      </div>
                    </li>
                  ))}
                </ol>
              )}
              {b.type === 'list' && b.items.length > MAX && (
                <button type="button" data-more data-count={b.items.length - MAX} data-more-label={t.seeMore} data-less={t.seeLess} aria-expanded="false" class="mt-3 w-full rounded-xl border border-line py-2 text-sm text-muted hover:border-accent/60 hover:text-text">
                  <span data-edit={k('seeMore')}>{t.seeMore}</span> ({b.items.length - MAX})
                </button>
              )}
              {b.type === 'avatar' && <WardrobeAvatar picks={b.picks} />}
            </div>
          ))}
        </div>
      </div>
    </div>
  ))}

  <p class="mt-3 text-xs leading-relaxed text-muted">
    <span data-edit={k('note')}>{t.note}</span> Recorded {fmtDate(demo.recorded)}. {demo.source}
  </p>
</section>

<style>
  .demo-tab[aria-selected='true'] { border-color: var(--color-accent); color: var(--color-text); }
  /* Before playback (only when JS runs): steps and result are hidden. */
  [data-demo].js .demo-step { opacity: .25; transition: opacity .35s ease; }
  [data-demo].js .demo-step .demo-line { display: none; }
  [data-demo].js .demo-step.is-running { opacity: 1; }
  [data-demo].js .demo-step.is-done { opacity: 1; }
  [data-demo].js .demo-step.is-done .demo-line { display: block; animation: demo-in .35s ease; }
  [data-demo].js .demo-step.is-running .demo-icon { border-color: var(--color-accent); border-top-color: transparent; animation: demo-spin .8s linear infinite; }
  [data-demo].js .demo-step.is-done .demo-icon { border-color: rgb(110 231 183 / .5); color: rgb(110 231 183); }
  [data-demo].js .demo-step.is-done[data-status='block'] .demo-icon { border-color: rgb(252 165 165 / .5); color: rgb(252 165 165); }
  [data-demo].js .demo-step.is-done .demo-icon::before { content: '✓'; }
  [data-demo].js .demo-step.is-done[data-status='block'] .demo-icon::before { content: '✕'; }
  [data-demo].js .demo-block { opacity: 0; transform: translateY(10px); transition: opacity .5s ease, transform .5s ease; }
  [data-demo].js .demo-block.is-shown { opacity: 1; transform: none; }
  [data-demo]:not(.js) .demo-waiting, [data-demo] .demo-run.has-result .demo-waiting { display: none; }
  @keyframes demo-spin { to { transform: rotate(360deg); } }
  @keyframes demo-in { from { opacity: 0; transform: translateY(-3px); } }

</style>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

  for (const root of document.querySelectorAll<HTMLElement>('[data-demo]')) {
    root.classList.add('js');
    const runs = [...root.querySelectorAll<HTMLElement>('.demo-run')];
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('.demo-tab')];
    let token = 0; // bumps on every new play, so an old playback stops
    let current = 0;

    const reset = (run: HTMLElement) => {
      run.classList.remove('has-result');
      run.querySelectorAll('.demo-step').forEach((s) => s.classList.remove('is-running', 'is-done'));
      run.querySelectorAll('.demo-block').forEach((b) => b.classList.remove('is-shown'));
    };
    const finish = (run: HTMLElement) => {
      run.querySelectorAll('.demo-step').forEach((s) => { s.classList.remove('is-running'); s.classList.add('is-done'); });
      run.classList.add('has-result');
      run.querySelectorAll('.demo-block').forEach((b) => b.classList.add('is-shown'));
    };

    async function play(i: number) {
      const my = ++token;
      const run = runs[i];
      reset(run);
      if (reduce) return finish(run);
      const steps = [...run.querySelectorAll<HTMLElement>('.demo-step')];
      for (const s of steps) {
        if (my !== token) return;
        s.classList.add('is-running');
        // Real run times are often milliseconds; pace them so people can follow.
        const ms = Number(s.dataset.ms) || 0;
        await sleep(Math.min(1600, 650 + Math.log10(ms + 10) * 220));
        if (my !== token) return;
        s.classList.remove('is-running');
        s.classList.add('is-done');
        await sleep(180);
      }
      run.classList.add('has-result');
      for (const b of run.querySelectorAll<HTMLElement>('.demo-block')) {
        if (my !== token) return;
        b.classList.add('is-shown');
        await sleep(260);
      }
      root.dispatchEvent(new CustomEvent('demo:done', { detail: i }));
    }

    function select(i: number, autoplay = true) {
      current = i;
      runs.forEach((r, j) => (r.hidden = j !== i));
      tabs.forEach((t, j) => t.setAttribute('aria-selected', String(j === i)));
      if (autoplay) play(i); else { token++; reset(runs[i]); }
    }

    tabs.forEach((t, i) => t.addEventListener('click', () => select(i)));
    root.querySelectorAll('[data-play]').forEach((b) => b.addEventListener('click', () => play(current)));
    root.querySelectorAll('[data-skip]').forEach((b) => b.addEventListener('click', () => { token++; finish(runs[current]); }));

    root.querySelectorAll<HTMLButtonElement>('[data-more]').forEach((btn) => btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') !== 'true';
      btn.parentElement!.querySelectorAll<HTMLElement>('.demo-more').forEach((li) => (li.hidden = !open));
      btn.setAttribute('aria-expanded', String(open));
      btn.firstElementChild!.textContent = open ? btn.dataset.less! : btn.dataset.moreLabel!;
      btn.lastChild!.textContent = open ? '' : ` (${btn.dataset.count})`;
    }));

    // Play the first scenario once it scrolls into view.
    const io = new IntersectionObserver((es) => {
      if (es.some((e) => e.isIntersecting)) { io.disconnect(); play(current); }
    }, { threshold: 0.2 });
    io.observe(root);
  }
</script>
